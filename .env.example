# ============================================================
# Jomish Business Suite — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to GitHub (it is already in .gitignore).
# On Render.com, set these in the Environment tab instead.
# ============================================================

# --- Server ---
PORT=3005
NODE_ENV=production

# --- JWT (Authentication) ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# --- Database ---
# Option A: Neon PostgreSQL (Recommended for Render hosting)
# Get this from: https://console.neon.tech → Your Project → Connection String
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Option B: Leave DATABASE_URL blank to use local SQLite (default for development)
# DATABASE_URL=
